# =========================================================================
# MÔI TRƯỜNG THỬ NGHIỆM ĐỘC LẬP (SUPABASE STAGING CONFIGURATION)
# DỰ ÁN: LÊ LỢI LOOP — THCS LÊ LỢI ĐÀ NẴNG
# =========================================================================
# LƯU Ý BẢO MẬT:
# 1. Dự án Staging là một project Supabase hoàn toàn tách biệt với Production.
# 2. KHÔNG BAO GIỜ nhập URL hoặc Anon Key của Production vào file này.
# 3. Sao chép file này thành .env.staging hoặc cấu hình trên Vercel Preview.
# =========================================================================

VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here

